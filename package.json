{
  "name": "atika",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait atika-postgres",
    "db:migrate": "pnpm --filter @atika/db db:migrate",
    "db:seed": "pnpm --filter @atika/db db:seed",
    "db:export-images": "pnpm --filter @atika/db db:export-images",
    "db:export-images-pdf": "pnpm --filter @atika/db db:export-images-pdf",
    "db:user": "pnpm --filter @atika/db db:user",
    "db:group": "pnpm --filter @atika/db db:group",
    "db:group-list": "pnpm --filter @atika/db db:group-list",
    "db:banks": "pnpm --filter @atika/db db:banks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
