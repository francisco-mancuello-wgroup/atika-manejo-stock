# Copy to .env at the repository root (gitignored). Loaded by prisma.config.ts, the seed and the ERP (apps/erp/next.config.ts).
DATABASE_URL=postgresql://atika:atika@localhost:5436/atika
# Directory holding the four inventory workbooks (kept outside the repository).
ATIKA_EXCEL_DIR=/path/to/stock-ropas
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Supabase Realtime: the ERP broadcasts "catalog changed" and open catalog pages refresh (both apps need both).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
