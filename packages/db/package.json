{
  "name": "@atika/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./categories": "./src/categories.ts",
    "./brands": "./src/brands.ts",
    "./password": "./src/password.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migration:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx seed/seed.ts",
    "db:export-images": "tsx seed/images/export-images.ts",
    "db:export-images-pdf": "tsx seed/images-pdf/export-images-pdf.ts",
    "db:export-looks": "tsx seed/categories/export-looks.ts",
    "db:user": "tsx seed/user.ts",
    "db:group": "tsx seed/group.ts",
    "db:group-list": "tsx seed/group-list.ts",
    "db:banks": "tsx seed/banks/seed-banks.ts"
  },
  "dependencies": {
    "@atika/pricing": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@atika/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
