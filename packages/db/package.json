{
  "name": "@atika/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migration:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx seed/seed.ts"
  },
  "dependencies": {
    "@atika/pricing": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "exceljs": "4.4.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@atika/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
