generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  lots      Lot[]

  @@map("suppliers")
}

/// A purchase from one supplier. Pricing parameters live here and are applied to every product.
model Lot {
  id               String         @id @default(uuid(7)) @db.Uuid
  supplierId       String         @db.Uuid
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  name             String
  purchasedAt      DateTime       @db.Date
  /// Guaraníes per US dollar.
  exchangeRate     Decimal        @db.Decimal(10, 2)
  saleFactor       Decimal        @db.Decimal(6, 3)
  /// Fraction, 0.1 = 10 %.
  vatRate          Decimal        @db.Decimal(5, 4)
  /// Share of the original value actually paid, fraction.
  costRate         Decimal        @db.Decimal(5, 4)
  /// `global` lots follow AppSettings; `custom` lots keep the four values above as edited in Compras.
  pricingMode      LotPricingMode @default(global)
  totalShippingUsd Decimal        @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  products         Product[]
  bankPromos       BankPromoLot[]

  @@index([supplierId])
  @@map("lots")
}

enum LotPricingMode {
  global
  custom

  @@map("lot_pricing_mode")
}

model Product {
  id               String             @id @default(uuid(7)) @db.Uuid
  lotId            String             @db.Uuid
  lot              Lot                @relation(fields: [lotId], references: [id])
  code             String?
  name             String
  brand            String?
  color            String?
  category         String?
  description      String?
  originalValueUsd Decimal            @db.Decimal(12, 2)
  /// Recalculated from lot parameters on save; read by the catalog.
  priceGs          Int
  isPublished      Boolean            @default(false)
  /// Lookbook placement: only pieces of a catalog are shown, in PDF page order.
  catalog          Catalog?
  catalogOrder     Int?
  catalogSection   String?
  /// Name shown in the lookbook; the workbook name is kept for the ERP and re-seeds.
  catalogName      String?
  /// Part of the Pink selection on the store's home (checked in the ERP lookbook form).
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  discounts        DiscountProduct[]
  bankPromos       BankPromoProduct[]

  @@index([lotId])
  @@index([isPublished])
  @@index([catalog])
  @@map("products")
}

/// A brand of the shop: each active one is a lookbook on the public catalog. `Product.brand` stays the
/// free text typed in the ERP and is matched to `key`; a missing or unknown brand lands on the fallback.
model Brand {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Display spelling.
  name       String
  /// lower(trim(name)): the case-insensitive identity of the brand.
  key        String   @unique
  /// Accent-free kebab slug of `/catalogos/<slug>`.
  slug       String   @unique
  /// An inactive brand disappears from the whole web (lookbook, Ver todo, product page, search, Pink, orders).
  isActive   Boolean  @default(true)
  /// Display order on the home; the fallback is always last.
  position   Int
  /// Uploaded cover; null falls back to the static cover of the original three, then to the first photo.
  coverUrl   String?
  /// "Otras marcas": where pieces without a brand (or with an unknown one) go. Exactly one row.
  isFallback Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("brands")
}

/// Legacy hand-set lookbooks. No longer read by the catalog (the lookbook is built by brand); kept so no data is lost.
enum Catalog {
  casa_icona @map("casa-icona")
  milonga
  sordo

  @@map("catalog")
}

/// One size of a product. Shipping is prorated over unitsBought; sales decrement stock.
model ProductVariant {
  id          String            @id @default(uuid(7)) @db.Uuid
  productId   String            @db.Uuid
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// XS, S, M, L, XL or U (one size).
  size        String
  unitsBought Int
  stock       Int
  sales       Sale[]
  orderItems  OrderItem[]
  allocations GroupAllocation[]
  /// Opaque internal code (AT000123) printed as a Code 128 barcode. Comes from a Postgres sequence, so it is never reused or changed.
  barcode     String            @unique @default(dbgenerated("('AT'::text || lpad((nextval('product_variant_barcode_seq'::regclass))::text, 6, '0'::text))"))

  @@unique([productId, size])
  @@map("product_variants")
}

/// A set of products published on the web, each size with an assigned quantity of the physical stock ("virtual stock").
/// Nothing is moved: the assignment only reserves part of `ProductVariant.stock` for the web while the group is active.
model PublicationGroup {
  id          String            @id @default(uuid(7)) @db.Uuid
  name        String
  isActive    Boolean           @default(false)
  /// Optional window; the group counts as active only inside it (and while `isActive`).
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  allocations GroupAllocation[]

  @@map("publication_groups")
}

/// Units of one size assigned to a group. `sold` counts the units of this variant sold while the group was active.
model GroupAllocation {
  id        String           @id @default(uuid(7)) @db.Uuid
  groupId   String           @db.Uuid
  group     PublicationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Restrict like Sale: a variant that sits in a group can't be deleted by accident and drop its sold history.
  variantId String           @db.Uuid
  variant   ProductVariant   @relation(fields: [variantId], references: [id])
  allocated Int
  sold      Int              @default(0)
  /// Event price for this size (the event workbook's price); null keeps the product's own price.
  priceGs   Int?

  @@unique([groupId, variantId])
  @@index([variantId])
  @@map("group_allocations")
}

model Sale {
  id          String         @id @default(uuid(7)) @db.Uuid
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int            @default(1)
  soldAt      DateTime       @db.Date
  /// Product price at the moment of the sale.
  listPriceGs Int
  /// Amount actually charged when it differs from the list price.
  chargedGs   Int?
  customer    String?
  notes       String?
  createdAt   DateTime       @default(now())
  /// Web order this sale came from (set when the order is approved); null for sales typed in the ERP.
  orderId     String?        @db.Uuid
  order       Order?         @relation(fields: [orderId], references: [id])

  @@index([variantId])
  @@index([soldAt])
  @@index([orderId])
  @@map("sales")
}

/// An order placed from the public cart. It never reserves stock: approving it in the ERP registers the sales.
model Order {
  id        String      @id @default(uuid(7)) @db.Uuid
  /// Human number shown as "Pedido #0042"; comes from a sequence, so it is never reused.
  number    Int         @unique @default(autoincrement())
  status    OrderStatus @default(pending)
  createdAt DateTime    @default(now())
  /// When it was approved or rejected.
  decidedAt DateTime?
  items     OrderItem[]
  sales     Sale[]

  @@index([status, createdAt])
  @@map("orders")
}

enum OrderStatus {
  pending
  approved
  rejected

  @@map("order_status")
}

/// One line of an order. Price and names are snapshots of what the catalog showed when it was placed.
model OrderItem {
  id              String         @id @default(uuid(7)) @db.Uuid
  orderId         String         @db.Uuid
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict like Sale: a variant with ordered lines can't be deleted by accident.
  variantId       String         @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  /// Price per unit the customer saw (discount included), computed on the server.
  unitPriceGs     Int
  /// Percent off included in `unitPriceGs`, or null.
  discountPercent Int?
  productName     String
  size            String
  color           String?

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  /// 0 is the cover image.
  position  Int
  /// Focal point in percent (0-100, 50 = center): the part kept visible when a frame crops the photo.
  focusX    Int     @default(50)
  focusY    Int     @default(50)
  /// Zoom in percent (0-100): 0 shows the whole photo, 100 fills the frame. Null = automatic (landscape photos whole, others fill).
  fit       Int?

  @@index([productId, position])
  @@map("product_images")
}

/// Percentage off the list price. The highest active discount covering a product wins.
model Discount {
  id        String            @id @default(uuid(7)) @db.Uuid
  name      String
  /// Integer 1-90.
  percent   Int
  isActive  Boolean           @default(true)
  /// First and last day (inclusive, Asunción calendar days); null = open-ended.
  startsAt  DateTime?         @db.Date
  endsAt    DateTime?         @db.Date
  scope     DiscountScope
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  /// Only used when scope is "selected".
  products  DiscountProduct[]

  @@map("discounts")
}

enum DiscountScope {
  all
  selected

  @@map("discount_scope")
}

model DiscountProduct {
  discountId String   @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

/// A bank shown in the catalog's promotions block.
model Bank {
  id        String          @id @default(uuid(7)) @db.Uuid
  name      String          @unique
  /// Public URL of the logo (stored like product photos); null = show the name instead.
  logoUrl   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  promos    BankPromoBank[]

  @@map("banks")
}

/// Informational card promotion (installments, refund or discount); never changes prices or sales.
model BankPromo {
  id        String             @id @default(uuid(7)) @db.Uuid
  kind      BankPromoKind
  /// Installments: integer 2-48. Refund and discount: integer percent 1-100.
  value     Int
  /// ISO weekdays it applies (1 = Monday ... 7 = Sunday); empty = every day.
  days      Int[]
  /// Maximum benefit in Gs; null = no cap.
  capGs     Int?
  /// First and last day (inclusive, Asunción calendar days); null = open-ended.
  startsAt  DateTime?          @db.Date
  endsAt    DateTime?          @db.Date
  terms     String?
  isActive  Boolean            @default(true)
  scope     BankPromoScope
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  banks     BankPromoBank[]
  /// Only used when scope is "lots".
  lots      BankPromoLot[]
  /// Only used when scope is "products".
  products  BankPromoProduct[]

  @@map("bank_promos")
}

enum BankPromoKind {
  installments
  refund
  discount

  @@map("bank_promo_kind")
}

enum BankPromoScope {
  all
  lots
  products

  @@map("bank_promo_scope")
}

model BankPromoBank {
  promoId String    @db.Uuid
  promo   BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  bankId  String    @db.Uuid
  /// Restrict: a bank used by a promo cannot be deleted.
  bank    Bank      @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@id([promoId, bankId])
  @@index([bankId])
  @@map("bank_promo_banks")
}

model BankPromoLot {
  promoId String    @db.Uuid
  promo   BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  lotId   String    @db.Uuid
  lot     Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@id([promoId, lotId])
  @@index([lotId])
  @@map("bank_promo_lots")
}

model BankPromoProduct {
  promoId   String    @db.Uuid
  promo     BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  productId String    @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoId, productId])
  @@index([productId])
  @@map("bank_promo_products")
}

/// Single row (id = 1) configured from the ERP and read by the catalog.
model CatalogSettings {
  id               Int      @id @default(1)
  whatsappNumber   String
  /// Supports {producto} and {talle} placeholders.
  messageTemplate  String
  heroText         String
  showPrices       Boolean  @default(true)
  showSoldOutSizes Boolean  @default(false)
  hideOutOfStock   Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("catalog_settings")
}

/// Single row (id = 1): the bank account shoppers pay into, shown on the store's /datos-bancarios
/// page. The printed QR points to that page, so editing these values never changes the QR.
model PaymentDetails {
  id         Int      @id @default(1)
  /// Razón social of the account holder.
  holderName String
  bank       String
  accountGs  String
  accountUsd String
  ruc        String
  updatedAt  DateTime @updatedAt

  @@map("payment_details")
}

/// Single row (id = 1) with the exchange rate of the day and the defaults for new lots.
model AppSettings {
  id           Int      @id @default(1)
  /// Guaraníes per US dollar.
  exchangeRate Decimal  @db.Decimal(10, 2)
  saleFactor   Decimal  @db.Decimal(6, 3)
  /// Fraction, 0.1 = 10 %.
  vatRate      Decimal  @db.Decimal(5, 4)
  /// Share of the original value actually paid, fraction.
  costRate     Decimal  @db.Decimal(5, 4)
  updatedAt    DateTime @updatedAt

  @@map("app_settings")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  /// scrypt hash, never the plain password.
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Single row (id = 1): counter the ERP bumps on every save the catalog shows. Open catalog pages
/// poll it and refresh when it changes.
model CatalogVersion {
  id        Int      @id @default(1)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("catalog_version")
}
