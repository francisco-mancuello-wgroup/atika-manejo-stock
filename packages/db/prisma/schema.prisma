generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  lots      Lot[]

  @@map("suppliers")
}

/// A purchase from one supplier. Pricing parameters live here and are applied to every product.
model Lot {
  id               String         @id @default(uuid(7)) @db.Uuid
  supplierId       String         @db.Uuid
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  name             String
  purchasedAt      DateTime       @db.Date
  /// Guaraníes per US dollar.
  exchangeRate     Decimal        @db.Decimal(10, 2)
  saleFactor       Decimal        @db.Decimal(6, 3)
  /// Fraction, 0.1 = 10 %.
  vatRate          Decimal        @db.Decimal(5, 4)
  /// Share of the original value actually paid, fraction.
  costRate         Decimal        @db.Decimal(5, 4)
  /// `global` lots follow AppSettings; `custom` lots keep the four values above as edited in Compras.
  pricingMode      LotPricingMode @default(global)
  totalShippingUsd Decimal        @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  products         Product[]
  bankPromos       BankPromoLot[]

  @@index([supplierId])
  @@map("lots")
}

enum LotPricingMode {
  global
  custom

  @@map("lot_pricing_mode")
}

model Product {
  id               String             @id @default(uuid(7)) @db.Uuid
  lotId            String             @db.Uuid
  lot              Lot                @relation(fields: [lotId], references: [id])
  code             String?
  name             String
  brand            String?
  color            String?
  category         String?
  description      String?
  originalValueUsd Decimal            @db.Decimal(12, 2)
  /// Recalculated from lot parameters on save; read by the catalog.
  priceGs          Int
  isPublished      Boolean            @default(false)
  /// Lookbook placement: only pieces of a catalog are shown, in PDF page order.
  catalog          Catalog?
  catalogOrder     Int?
  catalogSection   String?
  /// Name shown in the lookbook; the workbook name is kept for the ERP and re-seeds.
  catalogName      String?
  /// Part of the Pink selection on the store's home (checked in the ERP lookbook form).
  inPink           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  discounts        DiscountProduct[]
  bankPromos       BankPromoProduct[]

  @@index([lotId])
  @@index([isPublished])
  @@index([catalog])
  @@map("products")
}

/// The three lookbooks shown on the public catalog, in display order.
enum Catalog {
  casa_icona @map("casa-icona")
  milonga
  sordo

  @@map("catalog")
}

/// One size of a product. Shipping is prorated over unitsBought; sales decrement stock.
model ProductVariant {
  id          String  @id @default(uuid(7)) @db.Uuid
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// XS, S, M, L, XL or U (one size).
  size        String
  unitsBought Int
  stock       Int
  sales       Sale[]

  @@unique([productId, size])
  @@map("product_variants")
}

model Sale {
  id          String         @id @default(uuid(7)) @db.Uuid
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int            @default(1)
  soldAt      DateTime       @db.Date
  /// Product price at the moment of the sale.
  listPriceGs Int
  /// Amount actually charged when it differs from the list price.
  chargedGs   Int?
  customer    String?
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([variantId])
  @@index([soldAt])
  @@map("sales")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  /// 0 is the cover image.
  position  Int

  @@index([productId, position])
  @@map("product_images")
}

/// Percentage off the list price. The highest active discount covering a product wins.
model Discount {
  id        String            @id @default(uuid(7)) @db.Uuid
  name      String
  /// Integer 1-90.
  percent   Int
  isActive  Boolean           @default(true)
  /// First and last day (inclusive, Asunción calendar days); null = open-ended.
  startsAt  DateTime?         @db.Date
  endsAt    DateTime?         @db.Date
  scope     DiscountScope
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  /// Only used when scope is "selected".
  products  DiscountProduct[]

  @@map("discounts")
}

enum DiscountScope {
  all
  selected

  @@map("discount_scope")
}

model DiscountProduct {
  discountId String   @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
  @@map("discount_products")
}

/// A bank shown in the catalog's promotions block.
model Bank {
  id        String          @id @default(uuid(7)) @db.Uuid
  name      String          @unique
  /// Public URL of the logo (stored like product photos); null = show the name instead.
  logoUrl   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  promos    BankPromoBank[]

  @@map("banks")
}

/// Informational card promotion (installments, refund or discount); never changes prices or sales.
model BankPromo {
  id        String             @id @default(uuid(7)) @db.Uuid
  kind      BankPromoKind
  /// Installments: integer 2-48. Refund and discount: integer percent 1-100.
  value     Int
  /// ISO weekdays it applies (1 = Monday ... 7 = Sunday); empty = every day.
  days      Int[]
  /// Maximum benefit in Gs; null = no cap.
  capGs     Int?
  /// First and last day (inclusive, Asunción calendar days); null = open-ended.
  startsAt  DateTime?          @db.Date
  endsAt    DateTime?          @db.Date
  terms     String?
  isActive  Boolean            @default(true)
  scope     BankPromoScope
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  banks     BankPromoBank[]
  /// Only used when scope is "lots".
  lots      BankPromoLot[]
  /// Only used when scope is "products".
  products  BankPromoProduct[]

  @@map("bank_promos")
}

enum BankPromoKind {
  installments
  refund
  discount

  @@map("bank_promo_kind")
}

enum BankPromoScope {
  all
  lots
  products

  @@map("bank_promo_scope")
}

model BankPromoBank {
  promoId String    @db.Uuid
  promo   BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  bankId  String    @db.Uuid
  /// Restrict: a bank used by a promo cannot be deleted.
  bank    Bank      @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@id([promoId, bankId])
  @@index([bankId])
  @@map("bank_promo_banks")
}

model BankPromoLot {
  promoId String    @db.Uuid
  promo   BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  lotId   String    @db.Uuid
  lot     Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@id([promoId, lotId])
  @@index([lotId])
  @@map("bank_promo_lots")
}

model BankPromoProduct {
  promoId   String    @db.Uuid
  promo     BankPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  productId String    @db.Uuid
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promoId, productId])
  @@index([productId])
  @@map("bank_promo_products")
}

/// Single row (id = 1) configured from the ERP and read by the catalog.
model CatalogSettings {
  id               Int      @id @default(1)
  whatsappNumber   String
  /// Supports {producto} and {talle} placeholders.
  messageTemplate  String
  heroText         String
  showPrices       Boolean  @default(true)
  showSoldOutSizes Boolean  @default(false)
  hideOutOfStock   Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("catalog_settings")
}

/// Single row (id = 1): the bank account shoppers pay into, shown on the store's /datos-bancarios
/// page. The printed QR points to that page, so editing these values never changes the QR.
model PaymentDetails {
  id         Int      @id @default(1)
  /// Razón social of the account holder.
  holderName String
  bank       String
  accountGs  String
  accountUsd String
  ruc        String
  updatedAt  DateTime @updatedAt

  @@map("payment_details")
}

/// Single row (id = 1) with the exchange rate of the day and the defaults for new lots.
model AppSettings {
  id           Int      @id @default(1)
  /// Guaraníes per US dollar.
  exchangeRate Decimal  @db.Decimal(10, 2)
  saleFactor   Decimal  @db.Decimal(6, 3)
  /// Fraction, 0.1 = 10 %.
  vatRate      Decimal  @db.Decimal(5, 4)
  /// Share of the original value actually paid, fraction.
  costRate     Decimal  @db.Decimal(5, 4)
  updatedAt    DateTime @updatedAt

  @@map("app_settings")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  /// scrypt hash, never the plain password.
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}
